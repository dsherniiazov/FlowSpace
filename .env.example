# ============================================================
# FlowSpace - Environment Configuration Example
# Copy this file to .env and modify the values as needed.
# ============================================================

# ------------------------------------------------------------
# Required Configuration
# ------------------------------------------------------------
DB_URL=postgresql+psycopg://admin:admin@db:5432/flowspace
SECRET_KEY=replace-this-with-a-long-random-secure-string

# ------------------------------------------------------------
# Backend Runtime Settings
# ------------------------------------------------------------
RUN_MIGRATIONS=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enable automatic restart on code changes. Use only for local development.
RELOAD=false

# ------------------------------------------------------------
# File Storage
# ------------------------------------------------------------
FILES_DIR=/data/files
FILES_HOST_DIR=./.docker-data/files

# ------------------------------------------------------------
# Optional: Email (SMTP)
# ------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ------------------------------------------------------------
# Optional: OAuth Providers
# ------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# FRONTEND_URL=http://localhost:5173
# PUBLIC_API_URL=http://localhost:8000
